# ============================================================
# X-WRT build config для 4TomsOn fork — Routerich AX3000-V1 (mt76)
# Драйвер Wi-Fi: открытый mt76. Пакетный менеджер: apk.
# ============================================================

# ─── Пакетный менеджер (APK) ───
CONFIG_USE_APK=y

# ─── Утилиты базовые ───
CONFIG_PACKAGE_wget-ssl=y

# ─── Re:HomeProxy AutoMod (ezdizzy) ───
CONFIG_PACKAGE_luci-app-re-homeproxy=y
CONFIG_PACKAGE_luci-i18n-re-homeproxy-ru=y
CONFIG_PACKAGE_luci-i18n-homeproxy-ru=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_ucode-mod-digest=y

# ─── Мониторинг и ZRAM ───
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_vnstat2=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# ─── Целевая платформа ───
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# ─── Устройства ───
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netis_nx32u=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_routerich_ax3000-v1=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_routerich_ax3000=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y

# ============================================================
# ОТКРЫТЫЙ ДРАЙВЕР WI-FI (mt76) — основа для MT7981
# ============================================================
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76-connac=y

# ============================================================
# СЕТЕВОЕ УСКОРЕНИЕ (Software/Hardware Flow Offload)
# ============================================================
CONFIG_PACKAGE_kmod-nft-offload=y

# ============================================================
# Модули для прокси-клиентов (Re:HomeProxy)
# ============================================================
CONFIG_PACKAGE_kmod-nft-tproxy=m
CONFIG_PACKAGE_kmod-tun=m
CONFIG_PACKAGE_kmod-nft-socket=m
CONFIG_PACKAGE_kmod-inet-diag=m
CONFIG_PACKAGE_kmod-netlink-diag=m
CONFIG_PACKAGE_kmod-nft-fullcone=m
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# ============================================================
# USB / Extroot
# ============================================================
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_luci-app-blockmount=y

# ============================================================
# SQM / CAKE
# ============================================================
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-ifb=y

# ============================================================
# WireGuard заменяется на AmneziaWG
# ============================================================
# CONFIG_PACKAGE_kmod-wireguard is not set
CONFIG_PACKAGE_kmod-amneziawg=y
CONFIG_PACKAGE_amneziawg-tools=y
CONFIG_PACKAGE_luci-proto-amneziawg=y

# ============================================================
# Крипто-модули для WPA3/SAE (нужны для mt76)
# ============================================================
CONFIG_PACKAGE_kmod-crypto-ccm=y
CONFIG_PACKAGE_kmod-crypto-cmac=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-gf128=y
CONFIG_PACKAGE_kmod-crypto-ghash=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-md4=y
CONFIG_PACKAGE_kmod-crypto-md5=y
CONFIG_PACKAGE_kmod-crypto-seqiv=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-sha512=y

# ============================================================
# Тема / Полезные LuCI / Утилиты
# ============================================================
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-app-eqos-mtk=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo-ucode=y

# ============================================================
# Отключено
# ============================================================
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_FEED_video is not set
